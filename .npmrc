# Metro (React Native's bundler) resolves pnpm's symlinked node_modules badly.
# hoisted = npm-style flat tree. Costs pnpm's strictness, buys a working RN build.
# Revisit once apps/mobile is running: try removing this and see if Metro survives.
node-linker=hoisted

# Keep peer dep resolution honest even in hoisted mode.
strict-peer-dependencies=false
auto-install-peers=true
