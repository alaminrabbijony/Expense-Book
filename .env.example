# --- server ---
DATABASE_URL=postgresql://postgres:password@localhost:54321/expense_tracker
PORT=4000

# --- mobile ---
# A physical Android device cannot reach your machine on "localhost".
# Use your LAN IP (ip addr / ipconfig), e.g. 192.168.0.104.
# Android emulator instead uses the special host alias 10.0.2.2.
EXPO_PUBLIC_API_URL=http://192.168.0.104:4000
EXPO_PUBLIC_ELECTRIC_URL=http://192.168.0.104:3000
